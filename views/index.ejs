<%- include('partials/header') %>

<!-- Stats Bar -->
<section class="stats-bar">
  <p><strong><%= stats.total_orders %></strong> orders placed Nu. <strong><%= stats.total_revenue %></strong> in sales</p>
</section>

<!-- Popular Items -->
<% if (popularItems.length > 0) { %>
  <section class="popular">
    <h2>Popular Right Now</h2>
    <div class="popular-grid">
      <% popularItems.forEach(item => { %>
        <div class="popular-item">
          <h3><%= item.name %></h3>
          <span class="rating-pill"><%= item.times_ordered %> ordered</span>
        </div>
      <% }); %>
    </div>
  </section>
<% } %>

<!-- Restaurants List -->
<section class="restaurants">
  <h2>Restaurants</h2>
  <div class="restaurant-grid">
    <% restaurants.forEach(r => { %>
      <div class="restaurant-card">
        <h3><%= r.name %></h3>
        <p><%= r.cuisine %></p>
        <span class="rating">★ <%= r.rating %></span>
        <a href="/restaurants/<%= r.id %>/menu" class="btn">View Menu</a>
      </div>
    <% }); %>
  </div>
</section>

<%- include('partials/footer') %>
